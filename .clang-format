BasedOnStyle: WebKit

# Structural Layouts
UseTab: Always
TabWidth: 4
IndentWidth: 4
ColumnLimit: 120

# Alignment & Braces
BreakBeforeBraces: Attach
AlignAfterOpenBracket: Align

# Include Management
SortIncludes: false

# Enforce Left-Aligned (Typed) Pointers Everywhere
DerivePointerAlignment: false
PointerAlignment: Left

# Modern Layout Cleanup
SpaceAfterCStyleCast: true
